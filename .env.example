# Optional. Claude Code and Codex need no key, and an OpenRouter key can be added in the app's Settings.
# To use this file, copy it to .env and fill in only the providers you want. These keys stay on the server and are never sent to the browser.
# Mock models always work without any key.

# PORT=8787
# HOST=127.0.0.1

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=

# GEMINI_API_KEY=

# OPENROUTER_API_KEY=

# Local Ollama (no key needed). Detected automatically if running.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Any other OpenAI-compatible endpoint (Groq, Together, LM Studio, vLLM, ...)
# CUSTOM_OPENAI_LABEL=Groq
# CUSTOM_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# CUSTOM_OPENAI_API_KEY=
# CUSTOM_OPENAI_MODELS=llama-3.3-70b-versatile,qwen-qwq-32b

# Per-request provider timeout in milliseconds (the match settings can lower it).
# DECISION_TIMEOUT_MS=90000
