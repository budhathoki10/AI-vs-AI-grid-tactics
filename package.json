{
  "name": "uplink-duel",
  "private": true,
  "version": "1.0.0",
  "description": "A strictly turn-based AI-vs-AI tactical robot duel on an isometric battlefield.",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "series": "tsx scripts/series.ts",
    "smoke": "node scripts/smoke.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
